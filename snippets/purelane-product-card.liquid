{% comment %}
  Renders a Purelane product card using live Shopify product data.

  Accepts:
  - product: Product object (optional)
  - section_id: Owning section ID
  - index: 1-based card index (optional)
{% endcomment %}

{%- if product != blank -%}
  {%- liquid
    assign variant = product.selected_or_first_available_variant
    assign badge = product.metafields.custom.card_badge.value
    assign product_rating = product.metafields.reviews.rating.value
    assign rating_count = product.metafields.reviews.rating_count.value
    assign product_form_id = 'PlQuickAdd-' | append: section_id | append: '-' | append: product.id
    assign image_loading = 'lazy'
    if index != blank and index <= 4
      assign image_loading = 'eager'
    endif

    assign discount_percent = 0
    if variant.compare_at_price > variant.price
      assign discount_percent = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price
    endif
  -%}

  <article class="pl-product-card pl-glass">
    <a class="pl-product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {%- if badge != blank or product.available == false -%}
        <span class="pl-pill">
          {%- if product.available -%}{{ badge | escape }}{%- else -%}Sold out{%- endif -%}
        </span>
      {%- endif -%}
      {% render 'purelane-product-media',
        product: product,
        sizes: '(min-width: 990px) 22vw, (min-width: 600px) 44vw, 46vw',
        loading: image_loading
      %}
    </a>

    <div class="pl-product-card__body">
      <h3 class="pl-product-card__title">
        <a href="{{ product.url }}">{{ product.title | escape }}</a>
      </h3>

      {%- if product_rating != blank -%}
        <p class="pl-rating">
          <span
            class="pl-rating__score"
            role="img"
            aria-label="Rated {{ product_rating.rating }} out of {{ product_rating.scale_max }}"
          >
            <span aria-hidden="true">★</span> {{ product_rating.rating }}
          </span>
          {%- if rating_count != blank -%}
            <span aria-hidden="true"> · </span>
            <span>{{ rating_count }} reviews</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      <div class="pl-price">
        <strong>{{ variant.price | money }}</strong>
        {%- if variant.compare_at_price > variant.price -%}
          <s>{{ variant.compare_at_price | money }}</s>
          <span>{{ discount_percent }}% off</span>
        {%- endif -%}
      </div>

      <div class="pl-product-card__action">
        {%- if product.available == false -%}
          <button class="pl-button pl-button--secondary pl-button--small" type="button" disabled>Sold out</button>
        {%- elsif product.has_only_default_variant == false -%}
          <a class="pl-button pl-button--secondary pl-button--small" href="{{ product.url }}">Choose options</a>
        {%- else -%}
          <product-form data-section-id="{{ section_id }}">
            {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input type="hidden" name="id" value="{{ variant.id }}" class="product-variant-id">
              <button
                class="pl-button pl-button--secondary pl-button--small"
                type="submit"
                name="add"
                aria-label="Add {{ product.title | escape }} to cart"
              >
                <span>Add to cart</span>
                <span class="sold-out-message hidden">Sold out</span>
                {%- render 'loading-spinner' -%}
              </button>
            {%- endform -%}
          </product-form>
        {%- endif -%}
      </div>
    </div>
  </article>
{%- else -%}
  <article class="pl-product-card pl-glass pl-product-card--placeholder">
    <span class="pl-product-card__media">
      {% render 'purelane-product-media' %}
    </span>
    <div class="pl-product-card__body">
      <h3 class="pl-product-card__title">Select a product collection</h3>
      <p class="pl-rating">Products, prices and availability will appear automatically.</p>
      <div class="pl-price"><strong>{{ 20000 | money }}</strong></div>
      <button class="pl-button pl-button--secondary pl-button--small" type="button" disabled>Add to cart</button>
    </div>
  </article>
{%- endif -%}
