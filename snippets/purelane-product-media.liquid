{% comment %}
  Renders responsive Purelane product media with an accessible empty state.

  Accepts:
  - product: Product object (optional)
  - image: Image object override (optional)
  - media_class: Additional class for the wrapper (optional)
  - sizes: Responsive sizes string (optional)
  - loading: "eager" or "lazy" (optional)
  - fetchpriority: "high", "low", or "auto" (optional)
  - decorative: Empty alt text when true (optional)
{% endcomment %}

{%- liquid
  assign media = image
  if media == blank and product != blank
    assign media = product.featured_media.preview_image
  endif

  assign image_loading = loading | default: 'lazy'
  assign image_sizes = sizes | default: '(min-width: 990px) 25vw, 50vw'
  assign image_alt = media.alt | default: product.title
  if decorative
    assign image_alt = ''
  endif
-%}

<span class="pl-media{% if media_class != blank %} {{ media_class }}{% endif %}">
  {%- if media != blank -%}
    {{-
      media
      | image_url: width: 1200
      | image_tag:
        class: 'pl-media__image',
        widths: '165, 240, 360, 533, 720, 940, 1200',
        sizes: image_sizes,
        loading: image_loading,
        fetchpriority: fetchpriority,
        alt: image_alt
    -}}
  {%- else -%}
    <span
      class="pl-media__placeholder"
      role="img"
      aria-label="{% if product != blank %}{{ product.title | escape }} — image unavailable{% else %}Product image placeholder{% endif %}"
    >
      {{- 'product-1' | placeholder_svg_tag: 'pl-media__placeholder-svg' -}}
    </span>
  {%- endif -%}
</span>
