# Copy this file to .env.local for local development.
# In Vercel, set these values in the project's server-side environment variables.
# Never prefix credentials with NEXT_PUBLIC_ or commit .env.local.

# Google AI Studio API key. Required only when createResearchModel() is called.
GOOGLE_API_KEY=

# Exact Gemini model ID available to your Google account.
# Choose a model supporting tool calling and structured output. No automatic fallback.
GEMINI_MODEL=

# Perplexity Search API key. Required when researchProvider() is called (Phase 2).
PERPLEXITY_API_KEY=
