<section
  id="reviews"
  class="pl-section pl-reviews"
  data-pl-scene="1"
  aria-labelledby="PlReviewsHeading-{{ section.id }}"
>
  <div class="pl-wrap">
    <header class="pl-reviews__header pl-reveal">
      <h2 id="PlReviewsHeading-{{ section.id }}" class="pl-kicker">{{ section.settings.kicker | escape }}</h2>
      <p class="pl-reviews__aggregate">
        <span class="pl-stars" aria-hidden="true">★★★★★</span>
        <strong>{{ section.settings.average_rating | escape }}</strong>
        <span>{{ section.settings.review_count | escape }}</span>
      </p>
      <p class="pl-reviews__aggregate">
        {{ section.settings.social_proof_prefix | escape }}
        <strong>{{ section.settings.social_proof_value | escape }}</strong>
        {{ section.settings.social_proof_suffix | escape }}
      </p>
    </header>
  </div>

  <div
    class="pl-reviews__rail pl-reveal"
    tabindex="0"
    aria-label="Customer reviews. The list moves automatically; hover or focus to pause."
  >
    <div class="pl-reviews__track" style="--pl-review-duration: {{ section.settings.speed }}s">
      <div class="pl-reviews__group">
        {%- for block in section.blocks -%}
          <article class="pl-review-card pl-glass" data-pl-rail-card {{ block.shopify_attributes }}>
            <div class="pl-stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
              <span aria-hidden="true">
                {%- for star in (1..5) -%}{% if star <= block.settings.rating %}★{% else %}☆{% endif %}{%- endfor -%}
              </span>
            </div>
            <h3>{{ block.settings.title | escape }}</h3>
            <div class="pl-review-card__body rte">{{ block.settings.body }}</div>
            <p class="pl-review-card__author">
              {%- if block.settings.verified -%}
                <span class="pl-review-card__check" aria-label="Verified buyer">✓</span>
              {%- endif -%}
              <strong>{{ block.settings.author | escape }}</strong>
              {%- if block.settings.product != blank -%}
                <span aria-hidden="true">·</span>
                <a href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }}</a>
              {%- elsif block.settings.product_label != blank -%}
                <span aria-hidden="true">·</span>
                <span>{{ block.settings.product_label | escape }}</span>
              {%- endif -%}
            </p>
          </article>
        {%- else -%}
          <article class="pl-review-card pl-glass">
            <div class="pl-stars" aria-hidden="true">★★★★★</div>
            <h3>Add customer reviews</h3>
            <p>Reviews are editable blocks in the Shopify theme editor.</p>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="pl-reviews__group" aria-hidden="true">
          {%- for block in section.blocks -%}
            <article class="pl-review-card pl-glass">
              <div class="pl-stars">
                {%- for star in (1..5) -%}{% if star <= block.settings.rating %}★{% else %}☆{% endif %}{%- endfor -%}
              </div>
              <h3>{{ block.settings.title | escape }}</h3>
              <div class="pl-review-card__body rte">{{ block.settings.body }}</div>
              <p class="pl-review-card__author">
                {%- if block.settings.verified -%}<span class="pl-review-card__check">✓</span>{%- endif -%}
                <strong>{{ block.settings.author | escape }}</strong>
                {%- if block.settings.product != blank -%}
                  <span>·</span><span>{{ block.settings.product.title | escape }}</span>
                {%- elsif block.settings.product_label != blank -%}
                  <span>·</span><span>{{ block.settings.product_label | escape }}</span>
                {%- endif -%}
              </p>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane reviews",
  "tag": "section",
  "class": "purelane-reviews-section",
  "limit": 1,
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "average_rating",
      "label": "Average rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count text",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "social_proof_prefix",
      "label": "Social proof prefix",
      "default": "Loved by"
    },
    {
      "type": "text",
      "id": "social_proof_value",
      "label": "Social proof value",
      "default": "12 lakh+"
    },
    {
      "type": "text",
      "id": "social_proof_suffix",
      "label": "Social proof suffix",
      "default": "homes"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Marquee duration",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 10,
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Works like a charm"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Review",
          "default": "<p>Finally an eco option that cleans brilliantly and smells better.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Verified buyer"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified buyer",
          "default": true
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "product_label",
          "label": "Fallback product label",
          "default": "Homecare"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
