<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<section id="shop" class="pl-section pl-shop" data-pl-scene="3" aria-labelledby="PlShopHeading-{{ section.id }}">
  <div class="pl-wrap">
    <header class="pl-section-heading pl-reveal">
      {%- if section.settings.kicker != blank -%}
        <p class="pl-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h2 id="PlShopHeading-{{ section.id }}" class="pl-heading pl-heading--section">
        {{ section.settings.heading | escape }}
      </h2>
      <span class="pl-leaf-rule" aria-hidden="true">⌁</span>
    </header>

    <div class="pl-product-grid">
      {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <div class="pl-reveal" style="--pl-delay: {{ forloop.index0 | times: 70 }}ms">
            {% render 'purelane-product-card', product: product, section_id: section.id, index: forloop.index %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for index in (1..4) -%}
          <div class="pl-reveal" style="--pl-delay: {{ forloop.index0 | times: 70 }}ms">
            {% render 'purelane-product-card', section_id: section.id, index: index %}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane product grid",
  "tag": "section",
  "class": "purelane-shop-section",
  "limit": 1,
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Purelane product grid"
    }
  ]
}
{% endschema %}
