<section
  id="combos"
  class="pl-section pl-combos"
  data-pl-scene="3"
  aria-labelledby="PlCombosHeading-{{ section.id }}"
>
  <div class="pl-wrap">
    <header class="pl-section-heading pl-section-heading--left pl-reveal">
      {%- if section.settings.kicker != blank -%}
        <p class="pl-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h2 id="PlCombosHeading-{{ section.id }}" class="pl-heading pl-heading--section">
        {{ section.settings.heading | escape }}
      </h2>
      {%- if section.settings.copy != blank -%}
        <div class="pl-section-heading__copy rte">{{ section.settings.copy }}</div>
      {%- endif -%}
    </header>

    <div class="pl-combo-rail" tabindex="0" aria-label="Best-selling product bundles">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bundle = block.settings.product
          assign variant = bundle.selected_or_first_available_variant
          assign components = bundle.metafields.custom.bundle_components.value
          assign component_count = components.count | default: 0
          if bundle != blank and component_count == 0
            assign component_count = 1
          elsif bundle == blank
            assign component_count = 3
          endif

          assign savings = 0
          if variant.compare_at_price > variant.price
            assign savings = variant.compare_at_price | minus: variant.price
          endif
        -%}

        <article
          class="pl-combo-card pl-glass pl-reveal{% if block.settings.featured %} pl-combo-card--featured{% endif %}"
          data-pl-rail-card
          {{ block.shopify_attributes }}
        >
          <div class="pl-combo-card__tray">
            {%- if savings > 0 -%}
              <span class="pl-save-pill">Save {{ savings | money }}</span>
            {%- elsif block.settings.savings_label != blank -%}
              <span class="pl-save-pill">{{ block.settings.savings_label | escape }}</span>
            {%- endif -%}

            {%- if block.settings.flag != blank -%}
              <span class="pl-feature-pill">{{ block.settings.flag | escape }}</span>
            {%- endif -%}

            <div class="pl-component-stack" aria-label="{{ component_count }} products in this bundle">
              {%- if components != blank -%}
                {%- for component in components limit: 3 -%}
                  <div class="pl-component-stack__item">
                    {% render 'purelane-product-media',
                      product: component,
                      sizes: '(min-width: 990px) 9vw, 26vw'
                    %}
                    {%- if component.metafields.custom.card_benefit.value != blank -%}
                      <span>{{ component.metafields.custom.card_benefit.value | escape }}</span>
                    {%- endif -%}
                  </div>
                  {%- unless forloop.last -%}<span class="pl-component-stack__plus" aria-hidden="true">+</span>{%- endunless -%}
                {%- endfor -%}
              {%- elsif bundle != blank -%}
                <div class="pl-component-stack__item">
                  {% render 'purelane-product-media', product: bundle, sizes: '(min-width: 990px) 18vw, 55vw' %}
                  {%- if bundle.metafields.custom.card_benefit.value != blank -%}
                    <span>{{ bundle.metafields.custom.card_benefit.value | escape }}</span>
                  {%- endif -%}
                </div>
              {%- else -%}
                {%- for placeholder in (1..3) -%}
                  <div class="pl-component-stack__item">
                    {% render 'purelane-product-media' %}
                    <span>Product benefit</span>
                  </div>
                  {%- unless forloop.last -%}<span class="pl-component-stack__plus" aria-hidden="true">+</span>{%- endunless -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>

          <div class="pl-combo-card__body">
            <h3>
              {%- if bundle != blank -%}
                <a href="{{ bundle.url }}">{{ bundle.title | escape }}</a>
              {%- else -%}
                Select a fixed bundle product
              {%- endif -%}
            </h3>
            <p class="pl-combo-card__count">{{ component_count }} {% if component_count == 1 %}product{% else %}products{% endif %}</p>

            {%- if block.settings.summary != blank -%}
              <div class="pl-combo-card__summary rte">{{ block.settings.summary }}</div>
            {%- elsif bundle.description != blank -%}
              <p class="pl-combo-card__summary">{{ bundle.description | strip_html | truncatewords: 28 }}</p>
            {%- endif -%}

            {%- if bundle != blank -%}
              <div class="pl-price pl-price--large">
                <strong>{{ variant.price | money }}</strong>
                {%- if variant.compare_at_price > variant.price -%}
                  <s>{{ variant.compare_at_price | money }}</s>
                  <span>Save {{ savings | money }}</span>
                {%- endif -%}
              </div>
              <p class="pl-combo-card__fine">{{ section.settings.fine_print | escape }}</p>
              <a
                class="pl-button {% if block.settings.featured %}pl-button--primary{% else %}pl-button--secondary{% endif %} pl-button--full"
                href="{{ bundle.url }}"
              >
                {%- if bundle.available -%}{{ section.settings.button_label | escape }}{%- else -%}View sold-out bundle{%- endif -%}
                <span aria-hidden="true">→</span>
              </a>
            {%- else -%}
              <div class="pl-price pl-price--large"><strong>{{ 49900 | money }}</strong></div>
              <p class="pl-combo-card__fine">Select a Shopify product to show live pricing and availability.</p>
              <button class="pl-button pl-button--secondary pl-button--full" type="button" disabled>
                {{ section.settings.button_label | escape }}
              </button>
            {%- endif -%}
          </div>
        </article>
      {%- else -%}
        <article class="pl-combo-card pl-glass">
          <div class="pl-combo-card__body">
            <h3>Add bundle blocks</h3>
            <p>Choose fixed bundle products from Shopify in the theme editor.</p>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.swipe_cue != blank -%}
      <p class="pl-swipe-cue" aria-hidden="true">{{ section.settings.swipe_cue | escape }} <span>→</span></p>
    {%- endif -%}
    {%- if section.settings.note != blank -%}
      <p class="pl-rail-note">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane combos",
  "tag": "section",
  "class": "purelane-combos-section",
  "limit": 1,
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Curated for every corner" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Intro",
      "default": "<p>Ready-made sets for a cleaner home and an easier routine.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop bundle" },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "Inclusive of all taxes · COD available"
    },
    { "type": "text", "id": "swipe_cue", "label": "Mobile swipe cue", "default": "Swipe for more combos" },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Each button opens a real fixed-bundle product page with live price and stock."
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "combo",
      "name": "Fixed bundle",
      "settings": [
        { "type": "product", "id": "product", "label": "Fixed bundle product" },
        { "type": "checkbox", "id": "featured", "label": "Feature this card", "default": false },
        { "type": "text", "id": "flag", "label": "Flag", "default": "Most popular" },
        { "type": "text", "id": "savings_label", "label": "Fallback savings label", "default": "Bundle saving" },
        {
          "type": "richtext",
          "id": "summary",
          "label": "Summary",
          "info": "Leave blank to use the Shopify product description."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane combos",
      "blocks": [
        { "type": "combo", "settings": { "flag": "Most popular" } },
        { "type": "combo", "settings": { "flag": "" } },
        { "type": "combo", "settings": { "featured": true, "flag": "Best value", "savings_label": "Biggest saving" } },
        { "type": "combo", "settings": { "flag": "" } },
        { "type": "combo", "settings": { "flag": "" } }
      ]
    }
  ]
}
{% endschema %}
